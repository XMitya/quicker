<idea-plugin>
    <id>com.xmitya.quicker.endpoints</id>
    <name>Quicker Endpoints</name>
    <vendor url="https://github.com/XMitya/quicker">xmitya</vendor>

    <description><![CDATA[
      Jump straight to the controller method that serves a URL.
      <p>
      Paste a real URL out of a production log — <code>/api/v1/users/42/orders</code> — and it
      resolves against the split template <code>@RequestMapping("/api/v1/users")</code> +
      <code>@GetMapping("/{id}/orders")</code>, which plain text search can never find because the
      full path exists nowhere in the source.
      <p>
      Understands constant references, string concatenation, the API-interface/implementation split
      across modules, custom meta-annotations with <code>@AliasFor</code>, and
      <code>@HttpExchange</code>. Java and Kotlin. No Ultimate-only dependencies.
    ]]></description>

    <!--
      Shown as "What's new" on the Marketplace page and in the Plugin Manager. Only the versions
      worth a user's attention, newest first.
    -->
    <change-notes><![CDATA[
      <b>0.2.0</b>
      <ul>
        <li>Copy Endpoint Path and Copy Endpoint Path with Method in the editor's context menu: the
          full path of the handler method under the caret, resolved through the API
          interface/implementation split.</li>
      </ul>
      <b>0.1.3</b>
      <ul>
        <li>First JetBrains Marketplace release, under the MIT license.</li>
      </ul>
      <b>0.1.2</b>
      <ul>
        <li>Plugin icon.</li>
      </ul>
    ]]></change-notes>

    <!-- Java plugin: PSI, UAST, MetaAnnotationUtil, AnnotatedElementsSearch. -->
    <depends>com.intellij.java</depends>
    <!--
      No <depends> on Kotlin on purpose. Kotlin support arrives at runtime for free because the
      Kotlin plugin registers FirKotlinUastLanguagePlugin and KotlinAnnotatedElementsSearcher; we
      reference no org.jetbrains.kotlin.* class, so there is nothing to declare optional. Where the
      Kotlin plugin is absent, UastFacade simply has no plugin for .kt and those files are skipped.
    -->

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Quicker Endpoints" displayType="BALLOON"/>
        <applicationConfigurable
            parentId="tools"
            id="com.xmitya.quicker.endpoints.settings"
            displayName="Quicker Endpoints"
            instance="com.xmitya.quicker.endpoints.settings.EndpointConfigurable"/>
        <postStartupActivity implementation="com.xmitya.quicker.endpoints.model.EndpointStartupActivity"/>
        <appStarter implementation="com.xmitya.quicker.endpoints.diagnostic.EndpointDumpStarter"/>
        <searchEverywhereContributor
            implementation="com.xmitya.quicker.endpoints.se.EndpointSearchContributorFactory"/>
    </extensions>

    <actions>
        <action id="Quicker.GoToEndpoint"
                class="com.xmitya.quicker.endpoints.ui.GoToEndpointAction"
                text="Endpoint..."
                description="Find a Spring endpoint by URL, template or fragment"
                icon="AllIcons.Nodes.Related">
            <add-to-group group-id="GoToTargetEx" anchor="last"/>
            <!--
              Verified free across every bundled keymap and every <keyboard-shortcut> declared by
              the bundled plugins. "H" for HTTP.
            -->
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift H"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift H"/>
        </action>

        <!--
          The reverse of Go to Endpoint. Top level of the editor's context menu, right after the
          Copy/Paste block; both items show only on a handler method.
        -->
        <group id="Quicker.CopyEndpointPathGroup">
            <action id="Quicker.CopyEndpointPath"
                    class="com.xmitya.quicker.endpoints.ui.CopyEndpointPathAction"
                    text="Copy Endpoint Path"
                    description="Copy the full URL path this handler method serves, e.g. /api/v1/users/{id}"/>
            <action id="Quicker.CopyEndpointPathWithMethod"
                    class="com.xmitya.quicker.endpoints.ui.CopyEndpointPathWithMethodAction"
                    text="Copy Endpoint Path with Method"
                    description="Copy the HTTP method and the full URL path this handler serves, e.g. GET /api/v1/users/{id}"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Copy.Paste.Special"/>
        </group>
    </actions>
</idea-plugin>
